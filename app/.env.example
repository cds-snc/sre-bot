# Generated by bin/generate_env_example.py (make env-example); do not edit by hand.
#
# Every environment name a developer may set that no configuration file holds: the
# secrets and non-public values (decisions/configuration.md). Everything else lives in
# app/config/*.toml. Copy a line to app/.env, uncomment it and set the value there.
#
# Where a value comes from:
#   [codespaces] a Codespaces secret of the repository (the Codespace exports it; restart the Codespace after a change)
#   [devcontainer] the devcontainer's compose file sets it
#   [local] set it in app/.env yourself when you need it

# --- features.cloud_operations.spending.settings ---
# CLOUD_OPERATIONS_SPENDING__SHEET_ID=                 [codespaces] Google Sheets spreadsheet the AWS spending report is written to.

# --- features.incident.common.settings ---
# INCIDENT_CORE__FOLDER_ID=                            [codespaces] Google Drive folder holding every incident's folder.
# INCIDENT_CORE__REPORT_TEMPLATE_ID=                   [codespaces] Google Docs template a new incident report is copied from.
# INCIDENT_CORE__LIST_SHEET_ID=                        [codespaces] Google Sheets spreadsheet listing every incident.

# --- features.incident.postmortem.settings ---
# INCIDENT_POSTMORTEM__CALENDAR_ID=                    [codespaces] Google Calendar id the retro meeting is booked on.

# --- features.incident.response.settings ---
# INCIDENT_RESPONSE__HANDBOOK_ID=                      [codespaces] Google Docs id of the incident management handbook.

# --- features.talent.settings ---
# TALENT__INTERNAL_FOLDER_ID=                          [codespaces] Google Drive folder each role's folder is created in.
# TALENT__TEMPLATES_FOLDER_ID=                         [codespaces] Google Drive folder holding the hiring templates.
# TALENT__SCORING_GUIDE_TEMPLATE_ID=                   [codespaces] Google Docs template of the scoring guide.
# TALENT__CORE_VALUES_INTERVIEW_NOTES_ID=              [codespaces] Google Docs template of the core values interview notes.
# TALENT__TECHNICAL_INTERVIEW_NOTES_ID=                [codespaces] Google Docs template of the technical interview notes.
# TALENT__INTAKE_FORM_TEMPLATE_ID=                     [codespaces] Google Docs template of the intake form.
# TALENT__PHONE_SCREEN_TEMPLATE_ID=                    [codespaces] Google Docs template of the phone screen.
# TALENT__RECRUITMENT_FEEDBACK_TEMPLATE_ID=            [codespaces] Google Docs template of the recruitment feedback.
# TALENT__PANELIST_GUIDEBOOK_TEMPLATE_ID=              [codespaces] Google Docs template of the panelist guidebook.

# --- infrastructure.security.settings ---
# SECURITY__DEV_BYPASS_TOKEN=                          [local] Static bearer token the dev bypass accepts; set only with dev_bypass_enabled, never in production.

# --- integrations.aws.settings ---
# AWS__TENANT__INSTANCE_ID=                            [codespaces] Identity Center identity store id (d-xxxxxxxxxx), the AWS tenant id every Identity Store call carries.
# AWS__TENANT__INSTANCE_ARN=                           [codespaces] Identity Center instance ARN, as sso-admin calls name it.
# AWS__TENANT__AUDIT_ROLE_ARN=                         [codespaces] Role assumed in the audit account; empty uses the bot's own credentials.
# AWS__TENANT__ORG_ROLE_ARN=                           [codespaces] Role assumed in the organisation management account; empty uses the bot's own credentials.
# AWS__TENANT__LOGGING_ROLE_ARN=                       [codespaces] Role assumed in the logging account; empty uses the bot's own credentials.

# --- integrations.google_workspace.settings ---
# GOOGLE_WORKSPACE__TENANT__CUSTOMER_ID=               [codespaces] Real Google Workspace customer id, never the my_customer alias; a non-public value.
# GOOGLE_WORKSPACE__TENANT__SERVICE_ACCOUNT_KEY=       [codespaces] Service-account key JSON for this tenant.
# GOOGLE_WORKSPACE__TENANT__DELEGATED_USER_EMAIL=      [codespaces] Workspace user the service account impersonates when a caller names none; a non-public value.

# --- integrations.notify.settings ---
# NOTIFY__SRE_USER_NAME=                               [codespaces] Client id the JWT is issued for.
# NOTIFY__SRE_CLIENT_SECRET=                           [codespaces] Secret the JWT is signed with.

# --- integrations.openai.settings ---
# OPENAI__API_KEY=                                     [codespaces] API key for the tenant's endpoint.

# --- integrations.opsgenie.settings ---
# OPSGENIE__INTEGRATIONS_KEY=                          [codespaces] API key sent as the GenieKey authorization.

# --- integrations.sentinel.settings ---
# SENTINEL__CUSTOMER_ID=                               [codespaces] Log Analytics workspace id the events are sent to.
# SENTINEL__SHARED_KEY=                                [codespaces] Log Analytics workspace shared key that signs each send.

# --- integrations.slack.settings ---
# SLACK__BOT_TOKEN=                                    [codespaces] Bot token (xoxb-) the app acts with.
# SLACK__USER_TOKEN=                                   [codespaces] User token (xoxp-) for the calls a bot token cannot make.
# SLACK__APP_TOKEN=                                    [codespaces] App-level token (xapp-) Socket Mode connects with.
# SLACK__SIGNING_SECRET=                               [codespaces] Signing secret HTTP Events mode verifies requests with.

# --- integrations.trello.settings ---
# TRELLO__TENANT__APP_KEY=                             [codespaces] Trello Power-Up API key.
# TRELLO__TENANT__TOKEN=                               [codespaces] Trello user token the API key acts with.
# TRELLO__ATIP_BOARD=                                  [codespaces] Id of the ATIP Trello board.

# --- packages.access.common.settings ---
# ACCESS_PERMISSION_SETS__SYSTEM_ADMIN_PERMISSIONS=    [codespaces] Permission set ARN the access write alias resolves to.
# ACCESS_PERMISSION_SETS__VIEW_ONLY_PERMISSIONS=       [codespaces] Permission set ARN the access read alias resolves to.
