# SRE Bot: local development environment.
#
# Where values come from:
#   [codespaces]   a Codespaces secret for this repo (ask the SRE team for access);
#                  injected as an env var and overrides anything in app/.env
#   [devcontainer] set by .devcontainer/docker-compose.yml
#   [local]        set by you in app/.env (copy the [local] lines below)
# Every other setting has a working default; see the settings.py named per section.
# Real environment variables always override app/.env.
# Non-secret settings live in app/config/*.toml (base.toml, then local.toml); a value there needs no line here.
# Secrets and non-public values (decisions/configuration.md) are named <SLICE>__<FIELD>, never in the toml files.

# ── Deployment identity (server/configuration/identity.py) ──────────────────
# ENVIRONMENT=local                                [devcontainer] local, ci or production; selects app/config/<ENVIRONMENT>.toml

# ── Logging (infrastructure/logging/settings.py, [logging] in app/config) ───
# LOGGING__LOG_LEVEL=INFO                          [local] optional; `make debug` sets DEBUG

# ── API security (infrastructure/security/settings.py) ──────────────────────
# Local issuer served by `python3 bin/dev-token.py`:
SECURITY__ISSUERS='[{"issuer": "http://127.0.0.1:8001", "jwks_uri": "http://127.0.0.1:8001/.well-known/jwks.json", "algorithms": ["ES256"], "audience": "sre-bot-dev"}]'   # [local]
# SECURITY__DEV_BYPASS_ENABLED=true                [local] optional; production refuses to boot with it
# SECURITY__DEV_BYPASS_TOKEN=<long-random-string>  [local]
# SECURITY__CORS_ALLOWED_ORIGINS=["http://localhost:3000"]   [local] local frontend only; defaults in config/base.toml [security]

# ── Slack (integrations/slack/settings.py; workspace ids in config/local.toml [slack.tenant]) ──
# SLACK__BOT_TOKEN=                                [codespaces]
# SLACK__APP_TOKEN=                                [codespaces] Socket Mode
# SLACK__USER_TOKEN=                               [codespaces]
# SLACK__SIGNING_SECRET=                           [local] optional; HTTP mode only

# ── AWS (integrations/aws/settings.py; client tuning in config/base.toml [aws]) ──
# AWS_DEFAULT_REGION=ca-central-1                  [devcontainer] read by boto3; on ECS the platform sets it
# AWS_ENDPOINT_URL_DYNAMODB=http://dynamodb-local:8000   [devcontainer]
# Do not set AWS_ENDPOINT_URL: boto3 would route every AWS service to DynamoDB Local.
# The AWS organisation the bot manages (the tenant entry: present when the instance id is set):
# AWS__TENANT__INSTANCE_ID=                        [codespaces] Identity Center identity store id (d-...)
# AWS__TENANT__INSTANCE_ARN=                       [codespaces]
# AWS__TENANT__ORG_ROLE_ARN=                       [codespaces]
# AWS__TENANT__AUDIT_ROLE_ARN=                     [codespaces]
# AWS__TENANT__LOGGING_ROLE_ARN=                   [codespaces]

# ── Google Workspace (integrations/google_workspace/settings.py) ────────────
# GOOGLE_WORKSPACE__TENANT__CUSTOMER_ID=           [codespaces] the tenant entry is present when it is set
# GOOGLE_WORKSPACE__TENANT__SERVICE_ACCOUNT_KEY=   [codespaces] service-account JSON, not a path
# GOOGLE_WORKSPACE__TENANT__DELEGATED_USER_EMAIL=  [codespaces]
# GOOGLE_RESOURCES=                                [codespaces] incident folder, template and list ids (one key per id after TASK-111.10.3)

# ── Groups and directory (infrastructure/configuration/features/groups.py) ──
# GROUP_DOMAIN=                                    [codespaces]
# GROUP_PROVIDERS=                                 [codespaces]
# DIRECTORY_PROVIDER=google                        default

# ── Access package (packages/access/common/settings.py) ─────────────────────
ACCESS_CONFIG_SOURCE=file_json                     # [local]
ACCESS_CONFIG_REF=packages/access/access.local.json   # [local]
# ACCESS_SYNC_RECONCILIATION_ENABLED=true          [local] only after a validated dry run
# ACCESS_SYNC_RECONCILIATION_SCHEDULE=03:00        [local] daily, UTC
# ACCESS_PERMISSION_SETS__SYSTEM_ADMIN_PERMISSIONS=   [codespaces] permission-set ARN
# ACCESS_PERMISSION_SETS__VIEW_ONLY_PERMISSIONS=      [codespaces] permission-set ARN

# ── Incidents, ops channels and on-call (infrastructure/configuration/features/) ──
# INCIDENT_CHANNEL=                                [codespaces]
# SLACK_SECURITY_USER_GROUP_ID=                    [codespaces]
# SLACK_NOTIFY_MGMT_USER_GROUP_ID=                 [codespaces]
# SRE_OPS_CHANNEL_ID=                              [codespaces]
# INCIDENT_CORE__NEW_INCIDENT_SYSTEM=              [local] unset = legacy incident flow

# ── Vendor clients (integrations/<vendor>/settings.py; renamed to <VENDOR>__<FIELD> by TASK-111.11.2 and 111.12) ──
# OPENAI_API_KEY=                                  [codespaces]
# OPSGENIE_INTEGRATIONS_KEY=                       [codespaces]
# NOTIFY_API_URL=                                  [codespaces]
# NOTIFY_SRE_USER_NAME=                            [codespaces]
# NOTIFY_SRE_CLIENT_SECRET=                        [codespaces]
# TRELLO_APP_KEY=                                  [codespaces]
# TRELLO_TOKEN=                                    [codespaces]
# TRELLO_ATIP_BOARD=                               [codespaces]
# SENTINEL_CUSTOMER_ID=                            [codespaces]
# SENTINEL_SHARED_KEY=                             [codespaces]
# SENTINEL_LOG_TYPE=                               [codespaces]
# MAXMIND_KEY=                                     [codespaces] read by docker-compose (geolite download)
