{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Module",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "--factory",
                "main:create_app",
                "--reload"
            ],
            "env": {
                "ENVIRONMENT": "local",
                "LOGGING__LOG_LEVEL": "DEBUG"
            },
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/app"
        }
    ]
}